@prefix p: <http://www.fa.ru/prop/> .
@prefix pd: <http://www.fa.ru/prop/direct/> .
@prefix ps: <http://www.fa.ru/prop/statement/> .
@prefix pq: <http://www.fa.ru/prop/qualifier/>.
@prefix e: <http://www.fa.ru/entity/> .
@prefix s: <http://www.fa.ru/entity/statement/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

e:MoscowStateUniversity pd:IsA e:University ;
    pd:city e:Moscow ;
    pd:established "1755-01-25"^^xsd:date ;
    pd:rector e:Viktor_Sadovnichiy ;
    p:studentSize s:a1, s:a2, s:a3 .

s:a1 ps:studentSize "40000"^^xsd:integer ;
     pq:atYear "2000"^^xsd:gYear .

s:a2 ps:studentSize "38000"^^xsd:integer ;
     pq:atYear "2010"^^xsd:gYear .

s:a3 ps:studentSize "42000"^^xsd:integer ;
     pq:atYear "2020"^^xsd:gYear .

e:BaumanMoscowStateTechnicalUniversity pd:IsA e:University ;
    pd:city e:Moscow ;
    pd:established "1830-07-01"^^xsd:date ;
    pd:rector e:Anatoly_Aleksandrov ;
    p:studentSize s:b1, s:b2 .

s:b1 ps:studentSize "19000"^^xsd:integer ;
     pq:atYear "2005"^^xsd:gYear .

s:b2 ps:studentSize "21000"^^xsd:integer ;
     pq:atYear "2015"^^xsd:gYear .

e:SaintPetersburgStateUniversity pd:IsA e:University ;
    pd:city e:Saint_Petersburg ;
    pd:established "1724-01-28"^^xsd:date ;  
    pd:rector e:Nikolay_Kropachev ;
    p:studentSize s:c1, s:c2, s:c3, s:c4 .

s:c1 ps:studentSize "28000"^^xsd:integer ;
     pq:atYear "1995"^^xsd:gYear .

s:c2 ps:studentSize "30000"^^xsd:integer ;
     pq:atYear "2000"^^xsd:gYear .

s:c3 ps:studentSize "32000"^^xsd:integer ;
     pq:atYear "2010"^^xsd:gYear .

s:c4 ps:studentSize "30000"^^xsd:integer ;
     pq:atYear "2020"^^xsd:gYear .

e:SpbPolytechnicUniversity pd:IsA e:University ;
    pd:city e:Saint_Petersburg ;
    pd:established "1899-10-19"^^xsd:date ;  
    pd:rector e:Andrey_Rudskoy ;
    p:studentSize s:d1, s:d2, s:d3 .

s:d1 ps:studentSize "25000"^^xsd:integer ;
     pq:atYear "2000"^^xsd:gYear .   

s:d2 ps:studentSize "28000"^^xsd:integer ;
     pq:atYear "2010"^^xsd:gYear .

s:d3 ps:studentSize "33000"^^xsd:integer ;
     pq:atYear "2020"^^xsd:gYear .